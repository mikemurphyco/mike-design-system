#!/usr/bin/env bash
# Mike Murphy · design system pre-commit hook.
# Refuses any commit that introduces canon drift.
#
# Wired up via `git config core.hooksPath .githooks` (run once per clone —
# see package.json "prepare" script or README for the one-line setup).

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found on PATH; skipping canon check." >&2
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
node "$REPO_ROOT/scripts/check-canon.mjs" --quiet
node "$REPO_ROOT/scripts/check-version.mjs"

# If either check exits non-zero, this hook fails and the commit is blocked.
# To inspect:
#   `npm run check`         — full canon + version report
#   `npm run check-version` — version sync only
#   `npm run bump v2026.N`  — atomic version bump across all files
